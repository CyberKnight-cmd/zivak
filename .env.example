# ZIVAK environment variables — copy to .env and fill in your values
# Never commit .env to git

# ── LLM agents ──────────────────────────────────────────────────────────────
# Two separate Gemini API keys — one per agent to avoid rate limits
GEMINI_API_KEY_SELECTOR=
GEMINI_API_KEY_EVALUATOR=

# Alternative: use a local Ollama model instead of Gemini
USE_LOCAL_LLM=false
LOCAL_MODEL=llama3
LOCAL_LLM_URL=http://localhost:11434

# Alternative: use Groq (used by run_scenarios.py)
GROQ_API_KEY=

# ── API server ───────────────────────────────────────────────────────────────
# Bearer token checked on every /api/v1/* request — change before any shared deployment
API_KEY=your-secret-api-key

# Set to true to use mock clients (no Neo4j/Qdrant required)
USE_MOCK=false

# ── Neo4j (Aura or local) ────────────────────────────────────────────────────
NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_USER=<username>
NEO4J_PASSWORD=<password>

# ── Qdrant ───────────────────────────────────────────────────────────────────
# For Qdrant Cloud: set full https URL and API key
# For local Docker: http://localhost:6333 and leave QDRANT_API_KEY empty
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=symptoms
QDRANT_API_KEY=

# Minimum cosine similarity to accept a symptom match (default 0.60)
QDRANT_MATCH_THRESHOLD=0.60

# ── Embedding model ──────────────────────────────────────────────────────────
# Model used by scripts/8_populate_qdrant.py and knowledge/qdrant_client.py
# Must match — changing the model requires re-running scripts/8_populate_qdrant.py
EMBEDDING_MODEL=NeuML/pubmedbert-base-embeddings

# GPU batch size for embedding — reduce to 8 if CUDA OOM on small VRAM cards
EMBED_BATCH_SIZE=16

# ── Data paths (optional overrides) ─────────────────────────────────────────
# Defaults to data/ and data/raw/ relative to the project root
# DATA_DIR=
# ONTOLOGIES_DIR=
