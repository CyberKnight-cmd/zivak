# Neo4j connection
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here

# Data directory — path to data/processed/ folder
# Default: ../data (relative to exclusively-neo4j/)
# Change this if running from a different location
DATA_DIR=../data

# Ontologies directory — path to folder containing doid.obo, hp.obo, phenotype.hpoa
ONTOLOGIES_DIR=../data
